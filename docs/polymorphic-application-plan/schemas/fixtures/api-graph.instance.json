       "template": {
        "set": "// counts hits in a 60 s window; host.kv is the storage:kv capability binding (proposed)\nvar win = Math.floor(Date.now() / 60000);\nvar k = 'ratelimit/' + value.key + '/' + win;\nreturn host.kv.incr(k, value.cost || 1, { ttlMs: 120000 }).then(function (count) {\n  edges.count = { key: value.key, count: count, windowEndsAt: (win + 1) * 60000 };\n});\n",
        "vue": ""
       }
