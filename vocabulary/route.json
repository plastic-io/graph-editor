{
  "name": "Route",
  "description": "Sends the value out of the output named by one of its properties (by default 'kind'). Anything unmatched goes out unmatched. Max's route.",
  "icon": "mdi-directions-fork",
  "inputs": [
    "value"
  ],
  "outputs": [
    "a",
    "b",
    "unmatched"
  ],
  "set": "/**\n * Route: one value in, out of the output that its `kind` names.\n *\n * Max's `route`, on a named property rather than a leading symbol: set\n * `node.data.on` to the property to read (`kind` by default), name the outputs\n * after the values you expect, and anything else goes out `unmatched` — which\n * is there so a value nobody expected is visible rather than dropped.\n */\nnode.data = (node.data && typeof node.data === \"object\") ? node.data : {on: \"kind\"};\nconst key = value && typeof value === \"object\" ? value[node.data.on || \"kind\"] : value;\nconst names = (properties.outputs || []).map((o) => o.name);\nconst name = names.indexOf(String(key)) !== -1 ? String(key) : \"unmatched\";\nnode.data.last = name;\nif (names.indexOf(name) !== -1) {\n    edges[name] = value;\n}\n",
  "vue": "<template>\n  <v-card :width=\"width\" density=\"compact\">\n    <v-card-title class=\"text-body-2 py-1\"><v-icon size=\"small\" class=\"mr-1\">mdi-directions-fork</v-icon>Route</v-card-title>\n    <v-card-text class=\"py-1\">\n      <v-text-field density=\"compact\" variant=\"plain\" hide-details label=\"on which property\" v-model=\"on\"/>\n      <div class=\"text-caption mt-1\" v-if=\"last\"><span class=\"text-disabled\">last:</span> {{ last }}</div>\n      <v-divider class=\"my-1\"/>\n      <div class=\"d-flex align-center\" v-for=\"p in ports\" :key=\"p\">\n        <span class=\"text-caption\">{{ p }}</span>\n        <v-spacer/>\n        <v-icon size=\"x-small\" @click=\"remove(p)\" title=\"remove\">mdi-close</v-icon>\n      </div>\n      <div class=\"d-flex align-center mt-1\">\n        <v-text-field density=\"compact\" variant=\"plain\" hide-details placeholder=\"add an output\" v-model=\"fresh\" @keyup.enter=\"add\"/>\n        <v-icon size=\"small\" @click=\"add\" title=\"add\">mdi-plus</v-icon>\n      </div>\n    </v-card-text>\n  </v-card>\n</template>\n<script>\nexport default {\n  props: { node: Object, state: Object },\n  data() { return { width: 240, fresh: \"\" }; },\n  computed: {\n    on: {\n      get() { const d = this.node && this.node.data; return d && d.on !== undefined ? d.on : \"kind\"; },\n      set(v) { if (!this.node.data || typeof this.node.data !== \"object\") { this.node.data = {}; } this.node.data.on = v; },\n    },\n    last() { const d = this.node && this.node.data; return d && d.last ? d.last : \"\"; },\n    ports() { return ((this.node.properties && this.node.properties.outputs) || []).map((p) => p.name); },\n  },\n  methods: {\n    add() {\n      const name = (this.fresh || \"\").trim();\n      if (!name || this.ports.indexOf(name) !== -1) { return; }\n      this.node.properties.outputs = (this.node.properties.outputs || []).concat([{ name, type: \"Object\", external: false, visible: true }]);\n      this.node.edges = (this.node.edges || []).concat([{ field: name, connectors: [] }]);\n      this.fresh = \"\";\n    },\n    remove(name) {\n      this.node.properties.outputs = (this.node.properties.outputs || []).filter((p) => p.name !== name);\n      this.node.edges = (this.node.edges || []).filter((e) => e.field !== name);\n    },\n  },\n};\n</script>\n"
}
