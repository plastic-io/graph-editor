{
  "name": "graph-editor",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p build-only",
    "simulate": "npm run build && cd dist && npx ngx-http-server --baseHref graph-editor && cd ..",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:crdt": "vitest run --config vitest.packages.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:crdt:watch": "vitest --config vitest.packages.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "type-check:ratchet": "node scripts/type-check-ratchet.mjs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test:e2e:crdt": "vitest run --config vitest.e2e.config.ts",
    "test:hybrid": "playwright test"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.0.1",
    "@mdi/js": "^7.1.96",
    "@plastic-io/plastic-io": "^2.3.0",
    "bezier-js": "^6.1.0",
    "deep-diff": "^1.0.2",
    "file-saver": "^2.0.5",
    "flatted": "^3.2.7",
    "lib0": "^0.2.117",
    "moment": "^2.29.4",
    "monaco-editor": "^0.34.1",
    "monaco-volar": "^0.0.6",
    "openai": "^4.11.0",
    "pinia": "^2.1.7",
    "vue": "^3.3.13",
    "vue-router": "^4.1.6",
    "vuetify": "^3.0.2",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/deep-diff": "^1.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^18.11.9",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/compiler-sfc": "^3.2.45",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^8.22.0",
    "eslint-plugin-vue": "^9.3.0",
    "jsdom": "^20.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "typescript": "~4.7.4",
    "vite": "^4.4.9",
    "vite-plugin-vuetify": "^1.0.2",
    "vitest": "^0.34.4",
    "vue-tsc": "^1.0.9"
  }
}
