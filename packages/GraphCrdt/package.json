{
  "name": "@plastic-io/graph-crdt",
  "license": "BSD-3-Clause",
  "author": "TonyGermaneri@gmail.com",
  "version": "1.1.2",
  "private": false,
  "description": "Shared Yjs CRDT schema, codec and reconciler for Plastic-IO graphs.  Used by both the graph editor and the graph server, so it must never import Vue, Pinia, or any browser/node specific API.",
  "main": "./dist/main.js",
  "peerDependencies": {
    "yjs": "^13.6.0",
    "lib0": "^0.2.99"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
